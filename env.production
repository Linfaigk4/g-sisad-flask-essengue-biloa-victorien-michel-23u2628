# ============================================
# G-SISAD - PRODUCTION ENVIRONMENT VARIABLES
# ============================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=gsisad-production-secret-key-2024-very-secure-random-string

# Database (Render will provide DATABASE_URL automatically)
DATABASE_URL=sqlite:///gsisad.db

# Admin Configuration (create on first run)
ADMIN_EMAIL=admin@gsisad.com
ADMIN_PASSWORD=admin123

# Application Settings
APP_NAME=G-SISAD
APP_VERSION=1.0.0
DEBUG=False
TESTING=False

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# Performance
PREFETCH_DEFAULT_MAX_WORKERS=4
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# Email (optional - for password recovery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@gsisad.com

# Rate Limiting
RATELIMIT_DEFAULT=200 per day
RATELIMIT_STORAGE_URL=memory://

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/gsisad.log

# API Keys (if needed)
OPENAI_API_KEY=your-openai-key